{
  "rules": {
    ".read": false,
    ".write": false,

    "users": {
      ".read": "auth != null && auth.token.email != null && root.child('users').child(auth.token.email.replace('@luzglass.local','')).child('role').val() === 'admin'",
      ".write": "auth != null && auth.token.email != null && root.child('users').child(auth.token.email.replace('@luzglass.local','')).child('role').val() === 'admin'",
      "$phone": {
        ".read": "auth != null && auth.token.email != null && ($phone === auth.token.email.replace('@luzglass.local','') || root.child('users').child(auth.token.email.replace('@luzglass.local','')).child('role').val() === 'admin')",
        "password": { ".validate": false },
        "role":  { ".validate": "newData.isString() && (newData.val() === 'admin' || newData.val() === 'client')" },
        "phone": { ".validate": "newData.isString() && newData.val() === $phone" }
      }
    },

    "orders": {
      ".indexOn": ["clientPhone"],
      ".read": "auth != null && auth.token.email != null && (root.child('users').child(auth.token.email.replace('@luzglass.local','')).child('role').val() === 'admin' || (root.child('users').child(auth.token.email.replace('@luzglass.local','')).exists() && query.orderByChild === 'clientPhone' && query.equalTo === auth.token.email.replace('@luzglass.local','')))",
      "$orderId": {
        ".read": "auth != null && auth.token.email != null && (root.child('users').child(auth.token.email.replace('@luzglass.local','')).child('role').val() === 'admin' || data.child('clientPhone').val() === auth.token.email.replace('@luzglass.local',''))",
        ".write": "auth != null && auth.token.email != null && (root.child('users').child(auth.token.email.replace('@luzglass.local','')).child('role').val() === 'admin' || (root.child('users').child(auth.token.email.replace('@luzglass.local','')).exists() && !data.exists() && newData.child('clientPhone').val() === auth.token.email.replace('@luzglass.local','') && newData.child('stage').val() === '' && !newData.hasChild('pricesLockedAt') && !newData.hasChild('lockedItems') && !newData.hasChild('totalFinal') && !newData.hasChild('hashavshevetInvoice') && !newData.hasChild('isTest') && !newData.hasChild('monthlyBilling') && !newData.hasChild('readyStatus') && !newData.hasChild('sketchSeenAt')))",
        "clientPhone": { ".validate": "newData.isString()" }
      }
    },

    "sketches": {
      "$orderId": {
        ".read": "auth != null && auth.token.email != null && (root.child('users').child(auth.token.email.replace('@luzglass.local','')).child('role').val() === 'admin' || root.child('orders').child($orderId).child('clientPhone').val() === auth.token.email.replace('@luzglass.local',''))",
        ".write": "auth != null && auth.token.email != null && (root.child('users').child(auth.token.email.replace('@luzglass.local','')).child('role').val() === 'admin' || (!data.exists() && root.child('orders').child($orderId).child('clientPhone').val() === auth.token.email.replace('@luzglass.local','') && root.child('orders').child($orderId).child('stage').val() === ''))",
        ".validate": "newData.isString()"
      }
    },

    "workday": {
      ".read": "auth != null && auth.token.email != null && root.child('users').child(auth.token.email.replace('@luzglass.local','')).child('role').val() === 'admin'",
      ".write": "auth != null && auth.token.email != null && root.child('users').child(auth.token.email.replace('@luzglass.local','')).child('role').val() === 'admin'"
    },

    "checkEdits": {
      ".read": "auth != null && auth.token.email != null && root.child('users').child(auth.token.email.replace('@luzglass.local','')).child('role').val() === 'admin'",
      ".write": "auth != null && auth.token.email != null && root.child('users').child(auth.token.email.replace('@luzglass.local','')).child('role').val() === 'admin'"
    },

    "prices": {
      ".read": "auth != null && auth.token.email != null && root.child('users').child(auth.token.email.replace('@luzglass.local','')).child('role').val() === 'admin'",
      ".write": "auth != null && auth.token.email != null && root.child('users').child(auth.token.email.replace('@luzglass.local','')).child('role').val() === 'admin'",
      "global": {
        ".read": "auth != null && auth.token.email != null && root.child('users').child(auth.token.email.replace('@luzglass.local','')).exists()"
      },
      "clients": {
        "$customerId": {
          ".read": "auth != null && auth.token.email != null && (root.child('users').child(auth.token.email.replace('@luzglass.local','')).child('role').val() === 'admin' || root.child('users').child(auth.token.email.replace('@luzglass.local','')).child('customerId').val() === $customerId)"
        }
      },
      "clientKeys": {
        "$customerId": {
          ".read": "auth != null && auth.token.email != null && (root.child('users').child(auth.token.email.replace('@luzglass.local','')).child('role').val() === 'admin' || root.child('users').child(auth.token.email.replace('@luzglass.local','')).child('customerId').val() === $customerId)"
        }
      }
    },

    "skuCatalog": {
      ".read": "auth != null && auth.token.email != null && root.child('users').child(auth.token.email.replace('@luzglass.local','')).exists()",
      ".write": "auth != null && auth.token.email != null && root.child('users').child(auth.token.email.replace('@luzglass.local','')).child('role').val() === 'admin'"
    },

    "hashavshevetAccounts": {
      ".read": "auth != null && auth.token.email != null && root.child('users').child(auth.token.email.replace('@luzglass.local','')).child('role').val() === 'admin'",
      ".write": "auth != null && auth.token.email != null && root.child('users').child(auth.token.email.replace('@luzglass.local','')).child('role').val() === 'admin'"
    },

    "meta": {
      ".read": "auth != null && auth.token.email != null && root.child('users').child(auth.token.email.replace('@luzglass.local','')).child('role').val() === 'admin'",
      ".write": "auth != null && auth.token.email != null && root.child('users').child(auth.token.email.replace('@luzglass.local','')).child('role').val() === 'admin'",
      "orderCounter": {
        ".read": "auth != null && auth.token.email != null && root.child('users').child(auth.token.email.replace('@luzglass.local','')).exists()",
        ".write": "auth != null && auth.token.email != null && root.child('users').child(auth.token.email.replace('@luzglass.local','')).exists()",
        ".validate": "newData.isNumber() && (!data.exists() || (newData.val() > data.val() && newData.val() < data.val() + 1000))"
      },
      "chisumCounter": {
        ".validate": "newData.isNumber() && (!data.exists() || (newData.val() > data.val() && newData.val() < data.val() + 1000))"
      },
      "invoiceCounter": {
        ".validate": "newData.isNumber() && (!data.exists() || (newData.val() > data.val() && newData.val() < data.val() + 1000))"
      }
    },

    "clients": { ".read": false, ".write": false },

    "_test": {
      ".read": "auth != null && auth.token.email != null && root.child('users').child(auth.token.email.replace('@luzglass.local','')).child('role').val() === 'admin'",
      ".write": "auth != null && auth.token.email != null && root.child('users').child(auth.token.email.replace('@luzglass.local','')).child('role').val() === 'admin'"
    }
  }
}
